<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.T" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">monospace</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.T.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.T.Button.Secondary" parent="Widget.T.Button">
        <item name="android:background">@drawable/button_outline_secondary</item>
        <item name="android:textColor">@color/button_text_secondary</item>
    </style>
</resources>
